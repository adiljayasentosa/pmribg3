# =========================================================
# .gitignore — Website PMR WIRA UNIT
# =========================================================

# ── Dependencies ──
node_modules/

# ── Firebase ──
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.runtimeconfig.json

# ── Environment & Secrets ──
# [F8.0] Kritis: ImageKit Private Key & kredensial lain HANYA boleh
# ada di Vercel Environment Variables, tidak pernah di file lokal
# yang ter-commit.
.env
.env.*
!.env.example

# ── Vercel ──
.vercel/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build & Output ──
dist/
build/
.cache/
tmp/
temp/

# ── OS Files ──
.DS_Store
Thumbs.db

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── Archives ──
*.zip
*.rar
*.7z
